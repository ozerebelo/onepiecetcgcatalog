# Copy to .env.local (git-ignored) and fill in from Supabase:
# Dashboard → Project Settings → API (or the "Connect" dialog).
# Both values are public by design: they ship inside the app bundle.
# Row Level Security in the database is what protects user data.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key.
# NEVER put the secret / service_role key here.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
