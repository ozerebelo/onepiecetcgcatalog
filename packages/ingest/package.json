{
  "name": "@binder/ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Imports the official One Piece TCG card list (via the punk-records dataset) into the Postgres database.",
  "type": "module",
  "scripts": {
    "ingest": "tsx src/cli.ts",
