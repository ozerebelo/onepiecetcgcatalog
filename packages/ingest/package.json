    "migrate": "tsx src/migrate-cli.ts"
  },
  "dependencies": {
    "@binder/core": "workspace:*",
    "@supabase/supabase-js": "^2.118.0",
    "pg": "^8.23.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
