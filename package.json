{
  "name": "playset",
  "private": true,
  "description": "One Piece TCG collection tracker and deck checker (web, iOS, Android).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @binder/app start",
    "web": "pnpm --filter @binder/app web",
    "build:web": "pnpm --filter @binder/app build:web",
    "test": "pnpm -r --if-present test",
    "e2e": "pnpm --filter @binder/e2e e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "ingest": "pnpm --filter @binder/ingest ingest",
    "db:test": "bash scripts/db/test-local.sh",
    "db:migrate": "pnpm --filter @binder/ingest migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
